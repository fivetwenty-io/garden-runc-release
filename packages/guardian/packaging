#!/usr/bin/env bash
set -euo pipefail

mkdir -p "${BOSH_INSTALL_TARGET}/src"
mv * "${BOSH_INSTALL_TARGET}/src"
mv "${BOSH_INSTALL_TARGET}/src" .

source /var/vcap/packages/golang-*-linux/bosh/compile.env

mkdir -p "${BOSH_INSTALL_TARGET}/bin"
export GOBIN="${BOSH_INSTALL_TARGET}/bin"

pushd src/code.cloudfoundry.org/guardian
  go install -tags daemon ./cmd/gdn
  go install ./cmd/dadoo
  go install ./cmd/socket2me
  go install ./cmd/execas
popd

# vm-launch runs inside the container's rootfs, so it must be a static binary
# that does not depend on any shared library there. GOARCH is left to the
# compile environment, as for gdn above, so the binary matches the stemcell.
pushd src/code.cloudfoundry.org/guardian
  CGO_ENABLED=0 GOOS=linux go build -o "${BOSH_INSTALL_TARGET}/bin/vm-launch" ./cmd/vm-launch
popd

pushd src/code.cloudfoundry.org/guardian/rundmc/nstar
  make
  mv nstar "${BOSH_INSTALL_TARGET}/bin/nstar"
popd

pushd src/code.cloudfoundry.org/guardian/cmd/init
  gcc -static -o init init.c ignore_sigchild.c
  mv init "${BOSH_INSTALL_TARGET}/bin/init"
popd
